---
/* The catalog, rendered for one filter (all / a category / a sub-category).
   Every category and sub-category has its own URL. With JavaScript, switching between them
   happens in place with the animated picker and the URL updates; without it, the links just load the page. */
import { getData, imgUrl, itemsIn, shownCategories, catName } from '../lib/data';
import { worksCount, scriptJson } from '../lib/text';

interface Props { cat?: string; sub?: string }
const { cat = '', sub = '' } = Astro.props;
const d = await getData();
const cats = shownCategories(d);
const current = cats.find((c) => c.slug === cat);
const list = itemsIn(d, cat || undefined, sub || undefined);
const countText = (n: number) => worksCount(n) + (current ? ' ב' + (sub ? current.subs.find((s) => s.slug === sub)?.name : current.name) : '');
const urlFor = (c?: string, s?: string) => '/catalog/' + (c ? c + '/' : '') + (s ? s + '/' : '');

/* Data for in-place switching and the enlarged view */
const payload = {
  wa: d.settings.waNumber,
  cats: cats.map((c) => ({ slug: c.slug, name: c.name, subs: c.subs.map((s) => ({ slug: s.slug, name: s.name })) })),
  items: d.items.map((i) => ({ id: i.id, cat: i.cat, sub: i.sub, title: i.title, alt: i.alt, s: imgUrl(i.image, true), l: imgUrl(i.image), where: catName(d, i.cat, i.sub) })),
};
---
<div class="page-head">
  <div class="wrap">
    <h1 id="h-cat">קטלוג</h1>
    <p>כל העבודות כאן נעשו בהתאמה אישית. ראיתם משהו שאהבתם? לחצו על התמונה ושלחו לי אותה בוואטסאפ.</p>
  </div>
  <nav class="cat-rail" id="chips" aria-label="בחירת קטגוריה">
    <a class="cat" href={urlFor()} data-cat="" aria-current={!cat ? 'page' : undefined}>
      <span class="ring"><img class="logo-img" src="/logo/sara-icon.svg" alt="" width="78" height="78"></span>
      <span class="name">הכול</span><span class="n">{worksCount(d.items.length)}</span>
    </a>
    {cats.map((c) => (
      <a class="cat" href={urlFor(c.slug)} data-cat={c.slug} aria-current={cat === c.slug && !sub ? 'page' : cat === c.slug ? 'true' : undefined}>
        <span class="ring"><img src={imgUrl(c.cover && d.items.some((i) => i.image === c.cover) ? c.cover : itemsIn(d, c.slug)[0].image, true)} alt="" width="78" height="78" loading="lazy"></span>
        <span class="name">{c.name}</span><span class="n">{worksCount(itemsIn(d, c.slug).length)}</span>
      </a>
    ))}
  </nav>
  <div class="wrap">
    <nav class="subtabs" id="subchips" aria-label="בחירת סוג" hidden={!current || current.subs.length < 2}>
      <span class="ink" id="subInk" aria-hidden="true"></span>
      {current && current.subs.length >= 2 && [{ slug: '', name: 'הכול' }, ...current.subs].map((s) => (
        <a class="subtab" href={urlFor(current.slug, s.slug)} data-sub={s.slug} aria-current={sub === s.slug ? 'page' : undefined}>{s.name}</a>
      ))}
    </nav>
  </div>
</div>
<div class="wrap">
  <p class="count" id="count" aria-live="polite">{countText(list.length)}</p>
  <div class="grid" id="grid">
    {list.map((it, n) => (
      <a class="tile" href={`/cake/${it.id}/`} data-id={it.id} aria-label={`${it.title}, עבודה מספר ${it.id}`}>
        <img src={imgUrl(it.image, true)} alt="" loading={n < 6 ? 'eager' : 'lazy'} width="640" height="640">
        <span class="cap"><span>{it.title}</span><b>#{it.id}</b></span>
      </a>
    ))}
    {list.length === 0 && <p class="empty">עוד אין כאן עבודות. בקרוב!</p>}
  </div>
</div>

<dialog class="lb" id="lb" aria-labelledby="lbTitle">
  <button class="icon-btn lb-close" id="lbClose" type="button" aria-label="סגירה">✕</button>
  <div class="lb-inner">
    <div class="lb-img"><img id="lbImg" alt=""></div>
    <div class="lb-side">
      <span class="lb-num" id="lbNum"></span>
      <h2 id="lbTitle"></h2>
      <p id="lbCat"></p>
      <a class="btn btn-solid btn-wa" id="lbWa" target="_blank" rel="noopener" data-umami-event="whatsapp" data-umami-event-place="lightbox"><span class="dot" aria-hidden="true"></span>אני רוצה עוגה כזאת</a>
      <p class="hint">ההודעה תכלול את מספר העבודה, כדי שאדע על מה מדובר.</p>
      <a class="small-btn" id="lbPage" href="#">לעמוד של העבודה (לשיתוף)</a>
      <div class="lb-nav">
        <button class="icon-btn" id="lbPrev" type="button" aria-label="העבודה הקודמת">→</button>
        <button class="icon-btn" id="lbNext" type="button" aria-label="העבודה הבאה">←</button>
      </div>
    </div>
  </div>
</dialog>

<script type="application/json" id="catalogData" set:html={scriptJson(payload)} />

<script>
  import { initCatalog } from '../scripts/catalog';
  initCatalog();
</script>
