 "reviews": [
  {
   "id": 1,
   "text": "תודה רבה על הקינוחים המדהימים והעוגה המושקעת שהכנת לכבוד בת המצווה. תודה על ההשקעה, על תשומת הלב לכל פרט, ועל כך שאפילו קנית מפה במיוחד לכבוד האירוע. המחווה המרגשת והנתינה מכל הלב הוסיפו יופי, חום ומתיקות לחגיגה.",
   "tag": "בת מצווה",
   "visible": true,
   "sort": 0
  },
