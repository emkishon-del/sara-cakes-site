---
/* Admin page for Sara and Mani: /admin/. Not linked from the site and not indexed.
   Everything here runs in the browser against Supabase; access rules in the database decide who may edit. */
const configured = !!(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>ניהול · Sara Cakes & Sweets</title>
  <link rel="icon" href="/logo/sara-icon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700&family=Bellefair&display=swap">
</head>
<body>
  <a class="skip" href="#app">דלג לתוכן</a>
  <header class="a-head">
    <div class="a-brand"><img src="/logo/sara-icon.svg" alt="" width="40" height="40"><span>ניהול האתר</span></div>
    <div class="a-head-end" id="headEnd" hidden>
      <span class="pending" id="pending" hidden>יש שינויים שעוד לא פורסמו</span>
      <button class="a-btn a-primary" id="publishBtn" type="button">פרסום השינויים לאתר</button>
      <a class="a-btn" href="/" target="_blank" rel="noopener">לאתר</a>
      <button class="a-btn a-quiet" id="logoutBtn" type="button">יציאה</button>
    </div>
  </header>
  <div class="a-status" id="status" role="status" aria-live="polite"></div>
  <main id="app" tabindex="-1">
    {configured ? <p class="a-loading">טוען…</p> : (
      <section class="a-card a-narrow">
        <h1>עמוד הניהול עוד לא מחובר</h1>
        <p>כדי שהעמוד יעבוד צריך לחבר את Supabase: להגדיר את <code>PUBLIC_SUPABASE_URL</code> ואת <code>PUBLIC_SUPABASE_ANON_KEY</code> ב-Netlify ולפרסם מחדש. ההוראות נמצאות ב-README של הפרויקט.</p>
      </section>
    )}
  </main>
  <dialog class="a-dialog" id="dlg" aria-labelledby="dlgTitle"></dialog>

  {configured && (
    <script>
      import { initAdmin } from '../../scripts/admin';
      initAdmin();
    </script>
  )}
</body>
</html>

<style is:global>
  :root {
    --cream: #FDF8F3; --blush: #F5DED7; --paper: #FFFFFF; --ink: #3E2B20; --ink-2: #5A4436;
    --gold: #B8893F; --gold-text: #8A6224; --line: #E9D6CC; --ok: #1E7A43; --bad: #9B2C1F;
    --f-display: 'Bellefair', 'David', serif; --f-body: 'Assistant', Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--cream); color: var(--ink-2); font: 400 17px/1.5 var(--f-body); }
  h1, h2, h3 { font-family: var(--f-display); font-weight: 400; color: var(--ink); margin: 0; }
  :focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
  img { max-width: 100%; display: block; }
  .skip { position: absolute; top: -60px; inset-inline-start: 12px; background: var(--ink); color: #fff; padding: 8px 14px; border-radius: 8px; z-index: 50; }
  .skip:focus { top: 10px; }
  .a-head { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding: 12px max(16px, env(safe-area-inset-right, 0px)) 12px max(16px, env(safe-area-inset-left, 0px)); background: rgba(253, 248, 243, .95); border-bottom: 1px solid var(--line); backdrop-filter: blur(8px); }
  .a-brand { display: flex; align-items: center; gap: 10px; font: 400 1.5rem var(--f-display); color: var(--ink); }
  .a-head-end { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .pending { color: var(--gold-text); font-weight: 600; font-size: .95rem; }
  .a-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 8px 18px; border-radius: 999px; border: 1.5px solid var(--ink); background: var(--paper); color: var(--ink); font: 600 1rem var(--f-body); cursor: pointer; text-decoration: none; }
  .a-btn:disabled { opacity: .5; cursor: default; }
  .a-primary { background: var(--ink); color: #fff; }
  .a-quiet { border-color: var(--line); }
  .a-danger { border-color: var(--bad); color: var(--bad); }
  .a-danger.a-primary { background: var(--bad); color: #fff; }
  .a-small { min-height: 36px; padding: 4px 12px; font-size: .92rem; }
  .a-status { position: fixed; bottom: 18px; left: 50%; translate: -50% 0; z-index: 60; }
  .a-status:empty { display: none; }
  .a-status > div { background: var(--ink); color: #fff; padding: 10px 18px; border-radius: 999px; box-shadow: 0 8px 20px rgba(0,0,0,.2); }
  .a-status > .bad { background: var(--bad); }
  main { max-width: 1280px; margin: 0 auto; padding: 22px max(16px, env(safe-area-inset-right, 0px)) 80px max(16px, env(safe-area-inset-left, 0px)); }
  .a-loading { text-align: center; padding: 60px 0; }
  .a-card { background: var(--paper); border-radius: 16px; padding: 22px; box-shadow: 0 8px 24px rgba(110, 70, 45, .07); }
  .a-narrow { max-width: 460px; margin: 40px auto; display: grid; gap: 14px; }
  .a-tabs { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 20px; border-bottom: 1px solid var(--line); }
  .a-tab { border: 0; background: none; padding: 12px 18px; font: 600 1.05rem var(--f-body); color: var(--ink-2); cursor: pointer; border-bottom: 3px solid transparent; margin-bottom: -1px; min-height: 48px; }
  .a-tab[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--gold); }
  .a-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .a-spread { justify-content: space-between; }
  .a-field { display: grid; gap: 4px; }
  .a-field > span { font-weight: 600; color: var(--ink); font-size: .95rem; }
  .a-field small { color: var(--ink-2); }
  input[type=text], input[type=email], input[type=password], input:not([type]), select, textarea {
    font: 400 1rem var(--f-body); color: var(--ink); background: var(--cream); border: 1.5px solid var(--line); border-radius: 10px; padding: 9px 12px; min-height: 42px; width: 100%; }
  textarea { min-height: 90px; resize: vertical; }
  .a-err { color: var(--bad); }
  .a-help { font-size: .95rem; }
  .a-section { display: grid; gap: 16px; }
  .a-section + .a-section { margin-top: 28px; }
  .a-drop { border: 2px dashed var(--gold); border-radius: 16px; padding: 22px; text-align: center; background: #FFFBF6; display: grid; gap: 8px; justify-items: center; }
  .a-drop.over { background: #FBEFE4; }
  .a-queue { display: grid; gap: 12px; }
  .a-q { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 14px; align-items: start; }
  .a-q img { width: 120px; height: 120px; object-fit: cover; border-radius: 10px; }
  .a-q-fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }
  .a-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; }
  .a-item { background: var(--paper); border-radius: 14px; overflow: hidden; box-shadow: 0 4px 14px rgba(110, 70, 45, .08); display: grid; border: 2px solid transparent; }
  .a-item.hidden-item { opacity: .55; }
  .a-item.dragging { opacity: .3; }
  .a-item.drop-before { border-inline-start-color: var(--gold); }
  .a-item img { width: 100%; aspect-ratio: 1; object-fit: cover; cursor: grab; }
  .a-item-body { padding: 10px 12px 12px; display: grid; gap: 8px; }
  .a-item-title { color: var(--ink); font-weight: 600; line-height: 1.3; }
  .a-num { color: var(--gold-text); font-weight: 700; }
  .a-tag { font-size: .85rem; background: var(--cream); border-radius: 999px; padding: 2px 10px; }
  .a-switch { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-size: .95rem; }
  .a-switch input { width: 20px; height: 20px; accent-color: var(--ok); }
  .a-list { display: grid; gap: 12px; }
  .a-list-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: start; background: var(--paper); border-radius: 14px; padding: 14px; box-shadow: 0 4px 14px rgba(110, 70, 45, .06); }
  .a-tools { display: flex; gap: 6px; flex-wrap: wrap; }
  .a-picks { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }
  .a-pick { display: grid; gap: 8px; background: var(--paper); border-radius: 14px; padding: 14px; }
  .a-pick img { width: 100%; max-width: 220px; justify-self: center; aspect-ratio: 1; object-fit: cover; border-radius: 10px; background: var(--cream); }
  .a-price-sec { background: var(--paper); border-radius: 14px; padding: 16px; display: grid; gap: 10px; border-top: 3px solid var(--gold); }
  .a-price-row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr) auto; gap: 8px; align-items: center; }
  .a-dialog { border: 0; border-radius: 16px; padding: 0; width: min(560px, 94vw); }
  .a-dialog::backdrop { background: rgba(40, 26, 18, .6); }
  .a-dialog form { padding: 22px; display: grid; gap: 12px; }
  .a-dialog .a-thumb { width: 140px; aspect-ratio: 1; object-fit: cover; border-radius: 10px; }
  .a-progress { height: 6px; border-radius: 99px; background: var(--line); overflow: hidden; }
  .a-progress > i { display: block; height: 100%; background: var(--gold); width: 0; transition: width .3s; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 700px) { .a-q { grid-template-columns: 1fr; } .a-price-row { grid-template-columns: 1fr 1fr; } }
</style>
