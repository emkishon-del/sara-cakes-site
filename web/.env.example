# Copy to .env for local work, and set the same values in Netlify → Site configuration → Environment variables.
# Both are public by design (the database rules decide what they can do). Never put the service_role key here.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: cookieless visit counting with Umami (https://umami.is)
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# PUBLIC_UMAMI_ID=YOUR-WEBSITE-ID
